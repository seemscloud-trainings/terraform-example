mock_provider "google" {}

run "complete_pair_without_cycles" {
  command = apply
  variables {
    environment = "prod"

    project = "project-a"

    region = "europe-west1"

    router_a = {
      name    = "atlas"
      project = "project-a"
      network = "projects/project-a/global/networks/atlas"
      bgp = {
        asn = 65001
      }
    }

    gateway_a = {
      name    = "atlas"
      project = "project-a"
      network = "projects/project-a/global/networks/atlas"
    }

    router_b = {
      name    = "orion"
      project = "project-b"
      network = "projects/project-b/global/networks/orion"
      bgp = {
        asn = 65002
      }
    }

    gateway_b = {
      name    = "orion"
      project = "project-b"
      network = "projects/project-b/global/networks/orion"
    }

    links = {
      primary = {
        interface  = 0
        name_a     = "to-orion-primary"
        name_b     = "to-atlas-primary"
        ip_range_a = "169.254.10.1/30"
        ip_range_b = "169.254.10.2/30"
      }
      secondary = {
        interface  = 1
        name_a     = "to-orion-secondary"
        name_b     = "to-atlas-secondary"
        ip_range_a = "169.254.11.1/30"
        ip_range_b = "169.254.11.2/30"
      }
    }

    shared_secrets = {
      primary   = "replace-primary"
      secondary = "replace-secondary"
    }

    write_only_shared_secrets = {}
  }
  assert {
    condition     = module.router_a.router.name == "atlas" && module.router_b.router.name == "orion" && module.gateway_a.gateway.name == "atlas" && module.gateway_b.gateway.name == "orion" && length(module.tunnels.tunnels) == 4 && length(module.routing_a.interfaces) == 2 && length(module.routing_b.interfaces) == 2 && length(module.routing_a.peers) == 2 && length(module.routing_b.peers) == 2
    error_message = "Two atomic routers and gateways must compose with four tunnel endpoints and four BGP peers."
  }
  assert {
    condition     = module.tunnels.tunnels["a_primary"].router == module.router_a.router.self_link && module.routing_b.peers["primary"].peer_asn == module.router_a.router.asn
    error_message = "Router references and peer ASN must flow through outputs."
  }
}
