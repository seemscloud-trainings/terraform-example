environment = "prod"

project = "example-project"

region = "europe-west1"

zone = "europe-west1-b"

default_labels = {
  environment = "prod"
  region      = "europe-west1"
}

instance = {
  name         = "atlas"
  machine_type = "e2-micro"
  boot_disk = {
    initialize_params = {
      image = "debian-cloud/debian-12"
      size  = 10
      type  = "pd-balanced"
    }
  }
  network_interface = [

    {
      subnetwork = "projects/example-project/regions/europe-west1/subnetworks/atlas"
    }
    ,
  ]
  metadata = {
    enable-oslogin = "TRUE"
  }
}
